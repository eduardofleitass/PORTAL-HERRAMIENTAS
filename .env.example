# ============================================================
# Portal de Herramientas - Configuracion de despliegue
# ============================================================
# Copiar como .env y completar los valores.
#   cp .env.example .env
#
# Este archivo lo usa docker-compose. NO confundir con
# backend/.env, que es para ejecutar el backend sin Docker.
# ============================================================

# ---------- Obligatorio ----------
# Secreto para firmar los JWT. MINIMO 32 CARACTERES.
# Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------- Opcional ----------
# Puerto publico en el servidor (el interno siempre es 3001)
PORT_EXTERNO=3001

# Ventana de inactividad de la sesion (30s, 3m, 1h)
TOKEN_TTL=3m

# Rate limiting del login: intentos por IP dentro de la ventana
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEG=60

# Dominios permitidos por CORS, separados por coma.
# Vacio = solo mismo origen, que es lo correcto cuando el backend
# sirve el frontend. Definir solo si vas a exponer la API aparte.
# Ejemplo: https://portal.miempresa.com
CORS_ORIGINS=
