# ============================================================
# Portal de Herramientas EPEM — Configuracion del backend
# ============================================================
# Copiar este archivo como .env y ajustar los valores.
#   cp backend/.env.example backend/.env
#
# Ninguno de estos valores es obligatorio en desarrollo: si no se
# definen, se usan los defaults seguros de src/config.ts.
# ============================================================

# ---------- Servidor ----------
# Puerto donde escucha el backend
PORT=3001

# development | production
# En production: se sirve el frontend compilado y se ocultan detalles de errores
NODE_ENV=development

# ---------- Seguridad ----------
# Secreto para firmar los JWT. MINIMO 32 CARACTERES.
# Si no se define, se genera uno aleatorio y se guarda en data/.jwt-secret.
# En produccion DEBE definirse aqui.
# Generar uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duracion del token. Con sesion deslizante actua como ventana de inactividad.
# Formatos: 30s, 3m, 1h, 7d
TOKEN_TTL=3m

# ---------- Rate limiting de login ----------
# Intentos de login permitidos por IP dentro de la ventana
LOGIN_MAX_INTENTOS=5

# Ventana de tiempo del limite, en segundos
LOGIN_VENTANA_SEG=60

# ---------- CORS ----------
# Origenes permitidos, separados por coma.
# Vacio = solo origenes locales (desarrollo).
# Ejemplo produccion: https://portal.epem.com.py,https://portal-interno.epem.com.py
CORS_ORIGINS=

# ---------- Despliegue ----------
# Ruta al frontend compilado (solo si NODE_ENV=production y el dist
# no esta en la ubicacion por defecto ../frontend/dist)
PORTAL_FRONTEND_DIST=
