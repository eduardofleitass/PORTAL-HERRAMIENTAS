{
  "name": "portal-de-herramientas",
  "version": "1.0.0",
  "description": "Portal de Herramientas de Soporte",
  "main": "electron/main.cjs",
  "scripts": {
    "electron:dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on tcp:3001 tcp:5173 && electron .\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "electron:pack": "npm run build:frontend && npm run build:backend && electron-builder",
    "dist": "npm run build:frontend && npm run build:backend && electron-builder --win"
  },
  "build": {
    "appId": "com.drizzt.portalherramientas",
    "productName": "Portal de Herramientas",
    "directories": {
      "output": "dist-electron"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "electron/**/*",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.bin/**",
          "!node_modules/**"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*",
          "!*.exe",
          "!*.msi"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.0"
  }
}
